# Database
DATABASE_URL=postgresql+asyncpg://beerpong:beerpong_dev@localhost:5432/beerpong

# JWT — CHANGE secret_key IN PRODUCTION!
SECRET_KEY=CHANGE-ME-IN-PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# SMS
SMS_CODE_EXPIRE_MINUTES=5
SMS_CODE_LENGTH=6
SMS_BACKEND=dummy

# Abuse protection (defaults shown)
SMS_RESEND_COOLDOWN_SECONDS=60
SMS_MAX_REQUESTS_PER_HOUR=5
SMS_MAX_VERIFY_ATTEMPTS=5

# Origins allowed to call the API directly (comma separated). Add the address you open the app on, e.g. a phone:
# CORS_ORIGINS=http://localhost:3000,http://192.168.137.1:3000
CORS_ORIGINS=http://localhost:3000

# Set to "production" to refuse startup with SMS_BACKEND=dummy or the default SECRET_KEY
ENVIRONMENT=development
